{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermesmobile.dev/schemas/v0.1/requests/authorized-action.schema.json",
  "title": "AuthorizedAction",
  "type": "object",
  "required": ["message_type", "protocol_version", "request_id", "task_id", "span_id", "device_id", "tool", "parameters", "state_precondition", "verification", "idempotency_key", "attempt", "requested_at", "deadline", "action_digest", "effective_target", "effective_risk", "policy_decision_id", "execution_authorization", "authorization_algorithm", "authorization_key_id", "broker_id", "session_id", "sequence", "nonce", "issued_at", "expires_at"],
  "properties": {
    "message_type": {"const": "action.authorized"},
    "protocol_version": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/protocol_version"},
    "request_id": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/opaque_id"},
    "task_id": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/opaque_id"},
    "span_id": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/opaque_id"},
    "device_id": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/opaque_id"},
    "tool": {"enum": ["phone.read_screen", "phone.screenshot", "phone.tap", "phone.long_press", "phone.type", "phone.swipe", "phone.back", "phone.home", "phone.open_app", "phone.wait", "phone.notifications", "phone.current_app", "phone.device_state"]},
    "parameters": {"type": "object"},
    "state_precondition": {"oneOf": [{"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/state_precondition"}, {"type": "null"}]},
    "verification": {"oneOf": [{"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/verification_request"}, {"type": "null"}]},
    "idempotency_key": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/opaque_id"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 32},
    "requested_at": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/timestamp"},
    "deadline": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/timestamp"},
    "action_digest": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/sha256_digest"},
    "effective_target": {"oneOf": [{"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/semantic_target"}, {"type": "null"}]},
    "effective_risk": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
    "policy_decision_id": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/opaque_id"},
    "execution_authorization": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,8192}$"},
    "authorization_algorithm": {"const": "ES256"},
    "authorization_key_id": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/opaque_id"},
    "broker_id": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/opaque_id"},
    "session_id": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/opaque_id"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22,86}$"},
    "issued_at": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/timestamp"},
    "extensions": {"$ref": "https://hermesmobile.dev/schemas/v0.1/common/definitions.schema.json#/$defs/extensions"}
  },
  "additionalProperties": false
}
